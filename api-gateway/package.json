{
    "name": "meetingmind-api-gateway",
    "version": "1.0.0",
    "private": true,
    "description": "Cổng vào duy nhất của MeetingMind: kiểm tra token, giới hạn tần suất, định tuyến tới core-service",
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:prod": "node dist/main",
        "test": "jest"
    },
    "dependencies": {
        "@nestjs/common": "^11.1.3",
        "@nestjs/core": "^11.1.3",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/platform-express": "^11.1.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.7",
        "@nestjs/testing": "^11.1.3",
        "@types/express": "^5.0.2",
        "@types/jest": "29.5.14",
        "@types/node": "^22.15.3",
        "@types/supertest": "^6.0.3",
        "jest": "30.0.0",
        "supertest": "^7.1.1",
        "ts-jest": "29.4.0",
        "typescript": "^5.8.3"
    },
    "jest": {
        "moduleFileExtensions": ["js", "json", "ts"],
        "rootDir": ".",
        "testRegex": "test/.*\\.spec\\.ts$",
        "transform": { "^.+\\.ts$": "ts-jest" },
        "testEnvironment": "node"
    }
}
